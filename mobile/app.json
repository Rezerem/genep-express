{
  "expo": {
    "name": "Genep'express",
    "slug": "genepexpress",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.genepexpress.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Genep'express a besoin de ta position pour localiser les ravitailleurs proches.",
        "NSLocationAlwaysUsageDescription": "Les ravitailleurs partagent leur position en continu pour être localisables sur la carte."
      }
    },
    "android": {
      "package": "dev.genepexpress.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Les ravitailleurs partagent leur position en continu."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3dd68c"
        }
      ]
    ],
    "scheme": "genepexpress",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6101db4-1ab8-4034-8cc0-54d4b64c01ec"
      }
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f6101db4-1ab8-4034-8cc0-54d4b64c01ec"
    },
    "runtimeVersion": "0.1.0",
    "owner": "michizane"
  }
}
