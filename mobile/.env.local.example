# ─────────────────────────────────────────────────────────────────────────────
# Genep'express Mobile — Variables d'environnement
# Copier en .env.local — ne jamais commiter sur Git
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle (visibles côté client)
# ─────────────────────────────────────────────────────────────────────────────

# URL de l'API backend (localhost en dev, Render en prod)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Google OAuth Client ID (console.cloud.google.com)
# Un client par plateforme : Android + iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=xxx.apps.googleusercontent.com

# Clé MapTiler (maptiler.com/cloud → API Keys)
EXPO_PUBLIC_MAPTILER_KEY=votre_cle_ici
