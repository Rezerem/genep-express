# API Backend URL (use LAN IP in development, not localhost)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth 2.0 — Web Client ID
# Create in Google Cloud Console (APIs & Services → Credentials)
# Select "OAuth 2.0 Client IDs" → "Web application"
# Redirect URI: https://auth.expo.io/@<username>/<project-slug>
# This works for both iOS and Android development with Expo Go
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
