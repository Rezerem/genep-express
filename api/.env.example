# ─────────────────────────────────────────────────────────────────────────────
# Genep'express API — Variables d'environnement
# Copier en .env — ne jamais commiter .env sur Git
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# JWT — générer en prod : openssl rand -base64 32
JWT_SECRET=changez_moi_en_production

# PostgreSQL (Docker local : docker run --name genep-db ...)
DATABASE_URL="postgresql://genep:genep@localhost:5432/genepexpress"

# Redis (Docker local : docker run --name genep-redis ...)
REDIS_URL="redis://localhost:6379"

# Firebase FCM — console.firebase.google.com
# Paramètres projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@xxx.iam.gserviceaccount.com
